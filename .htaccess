# ═══════════════════════════════════════════════════════════
# SIMC — Directivas de Seguridad del Servidor Web Apache (.htaccess)
# ═══════════════════════════════════════════════════════════

# 1. Deshabilitar listado de directorios (Anti Directory Browsing)
Options -Indexes

# 2. Codificación por defecto UTF-8
AddDefaultCharset UTF-8

# 3. Proteger archivos sensibles del sistema
<FilesMatch "^(\.env|\.git|\.htaccess|\.htpasswd|composer\.(json|lock)|package(-lock)?\.json|.*\.sql|.*\.log|.*\.md)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# 4. Cabeceras de Seguridad a Nivel Servidor (mod_headers)
<IfModule mod_headers.c>
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(self), microphone=(self), geolocation=()"
</IfModule>
